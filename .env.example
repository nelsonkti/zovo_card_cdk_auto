# Copy this file to .env for local development.
# Existing shell environment variables take precedence over this file.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

# Choose: sqlite or postgres
DB_DRIVER=sqlite
# SQLite only. Relative paths are resolved from this env file's directory.
DB_PATH=data/cdk_recharge.db

# PostgreSQL settings (used when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cdk_recharge
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_HOURS=24
